{
  "name": "sekai-reader",
  "version": "0.1.0",
  "private": true,
  "description": "Project SEKAI TC story reader as a vertical comic",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run && npm run -s test:py",
    "build:episode": "tsx scripts/build_episode.ts",
    "test:py": "python3 -m unittest discover -s tests -p \"test_*.py\""
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^26.1.0",
    "playwright-core": "1.48.2",
    "sharp": "^0.34.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
