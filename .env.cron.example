# sekai-reader hourly trigger. scripts/pipeline/setup-cron.sh copies this file to .env.cron (git-ignored),
# opens it in Notepad, deploys the Cloudflare Worker, stores the GitHub token as a Worker secret, then
# deletes the file. Fill in the value after each '='. No quotes, no spaces around '='.

# GitHub > Settings > Developer settings > Personal access tokens > Fine-grained tokens > Generate new token:
# Repository access: Only select repositories > cholateio/sekai-reader
# Repository permissions: Actions > Read and write (nothing else). Expiration: the longest offered.
GH_DISPATCH_TOKEN=

# Cloudflare dashboard > My Profile > API Tokens > Create Token > Create Custom Token:
# permission Account > Workers Scripts > Edit, Account Resources: your account. Name e.g. "sekai-reader cron token".
CLOUDFLARE_API_TOKEN=

# Cloudflare dashboard > Workers & Pages > Account Details > Account ID (same value as before).
CLOUDFLARE_ACCOUNT_ID=
