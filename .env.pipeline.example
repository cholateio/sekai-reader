# sekai-reader pipeline secrets. scripts/pipeline/setup.sh copies this file to .env.pipeline
# (git-ignored), opens it in Notepad, uploads it with `gh secret set -f`, then deletes it.
# Fill in the value after each '='. No quotes, no spaces around '='.

# Anthropic Console > Settings > API keys > Create key (use this key only for this pipeline).
# Also set a monthly spend limit in Console > Settings > Limits (suggested US$80).
ANTHROPIC_API_KEY=

# Cloudflare dashboard > My Profile > API Tokens > Create Token > Custom:
# permission Account > Cloudflare Pages > Edit, limited to your account.
CLOUDFLARE_API_TOKEN=

# Cloudflare dashboard > any domain or Workers & Pages overview > right side "Account ID".
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare dashboard > R2 > Manage R2 API Tokens > Create API token:
# permission Object Read & Write, limited to the bucket sekai-reader-assets.
# The page shows "Access Key ID" and "Secret Access Key" once; copy both here.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
